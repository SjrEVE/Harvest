# Intermediates
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/*
# RC3 release evidence is a deliverable, not regenerated build junk.
!build/RC3-final-1e65962/
!build/RC3-final-1e65962/*
dist/
*.egg-info/

# Local captures — a real payload must never become a committed file.
data/
captures/
local-captures/
*.raw.json
*.raw.json.gz
warehouse*.sqlite
warehouse*.sqlite-wal
warehouse*.sqlite-shm
santhau*.db
backups/
exports/
attachments/

# Real-data quarantine staging used by the sanitizer (lives outside the repo by default)
/tmp-real/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Secret material, whatever the gate says
.env
.env.*
!.env.example
*.pem
*.p12
*.key

# Benchmark scratch: 100k+ synthetic object files, never a commit target.
_evidence/*/bench-work/

# Benchmark/evidence outputs (synthetic, regenerated per run)
_evidence/
