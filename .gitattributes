# Line endings are normalised in the repository so a checkout on Windows cannot
# corrupt the shell hook: a CRLF pre-commit script fails with "\r: command not found".
* text=auto

*.sh text eol=lf
pre-commit text eol=lf
*.py text eol=lf
*.qml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.png binary
*.gz binary
*.exe binary
*.dll binary
*.pyd binary
