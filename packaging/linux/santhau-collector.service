[Unit]
Description=San Thau collector (no GUI or statistics)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/santhau-collector/santhau-collector run
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=default.target
