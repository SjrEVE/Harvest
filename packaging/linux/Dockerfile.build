FROM ghcr.io/astral-sh/uv:0.12.13 AS uv
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git gcc g++ make patchelf ccache xz-utils dpkg-dev \
    libssl3 libffi8 libsqlite3-0 liblzma5 libbz2-1.0 zlib1g \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_CACHE_DIR=/opt/uv-cache
RUN uv python install 3.12.14 && uv venv /opt/build-venv --python 3.12.14
COPY packaging/linux/requirements.txt /tmp/build-requirements.txt
RUN uv pip install --python /opt/build-venv/bin/python --require-hashes -r /tmp/build-requirements.txt
ENV PATH=/opt/build-venv/bin:$PATH PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
